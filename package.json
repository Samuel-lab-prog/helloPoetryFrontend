{
	"name": "hello-poetry-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint . --no-cache",
		"lint:fix": "eslint . --fix --no-cache",
		"format": "prettier --check .",
		"format:fix": "prettier --write . --log-level silent",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"generate": "chakra typegen ./src/core/themes/main.ts --strict",
		"barrels": "barrelsby --config barrels.config.json",
		"check-deps": "node scripts/check-dependencies.mjs",
		"test:check-deps": "node --test scripts/check-dependencies.test.mjs",
		"check:structure": "node architecture-analysis/src/checks/check-structure.mjs",
		"test:architecture": "node --test architecture-analysis/src/checks/check-structure.test.mjs architecture-analysis/src/checks/module-boundaries.test.mjs",
		"check:architecture": "bun run check:structure && bun run test:check-deps && bun run test:architecture && bun run check-deps",
		"metrics:cloc": "cloc src --by-file --exclude-dir=node_modules,dist,build,coverage --json --out cloc.json --quiet",
		"metrics:depcruise": "depcruise \"src/**/*.{ts,tsx}\" --exclude \"node_modules|dist|coverage\" --output-type json --output-to depcruise.json",
		"metrics:analysis": "bun architecture-analysis/src/main.ts",
		"metrics": "bun run metrics:cloc && bun run metrics:depcruise && bun run metrics:analysis",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:access": "playwright test e2e/access-control/logged-out.spec.ts",
		"test:e2e:auth": "playwright test e2e/auth/logged-out.spec.ts e2e/auth/sign-out.spec.ts e2e/auth/session-expiration.spec.ts e2e/auth/banned-session.spec.ts",
		"test:e2e:authors": "playwright test e2e/authors/logged-out.spec.ts",
		"test:e2e:home": "playwright test e2e/home/logged-out.spec.ts",
		"test:e2e:logged-out": "playwright test e2e/access-control/logged-out.spec.ts e2e/access-control/navbar-logged-out.spec.ts e2e/auth/logged-out.spec.ts e2e/auth/sign-out.spec.ts e2e/auth/session-expiration.spec.ts e2e/home/logged-out.spec.ts e2e/poets/logged-out.spec.ts e2e/poems/logged-out-interactions.spec.ts e2e/poems/logged-out-immersive.spec.ts e2e/authors/logged-out.spec.ts",
		"test:e2e:navbar": "playwright test e2e/access-control/navbar-logged-out.spec.ts",
		"test:e2e:poets": "playwright test e2e/poets/logged-out.spec.ts",
		"test:e2e:poems": "playwright test e2e/poems/logged-out-interactions.spec.ts e2e/poems/logged-out-immersive.spec.ts",
		"test:e2e:ui": "playwright test --ui",
		"perf:navigation": "playwright test e2e/perf/navigation.spec.ts",
		"perf:navigation:ui": "playwright test e2e/perf/navigation.spec.ts --ui",
		"depcruise": "bun run check-deps",
		"check:static": "bun run lint && bun run format && bun run check:architecture && bun run typecheck",
		"check": "bun run check:static && bun run typecheck",
		"generate:api": "orval"
	},
	"dependencies": {
		"@chakra-ui/react": "^3.30.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@hookform/resolvers": "^5.2.2",
		"@tanstack/react-query": "^5.90.12",
		"framer-motion": "^12.23.26",
		"lucide-react": "^0.556.0",
		"next-themes": "^0.4.6",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-hook-form": "^7.65.0",
		"react-icons": "^5.6.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.9.4",
		"remark-gfm": "^4.0.1",
		"zod": "^4.1.12",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@chakra-ui/cli": "3.30.0",
		"@eslint/js": "^9.33.0",
		"@playwright/test": "^1.59.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.12.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.0",
		"barrelsby": "^2.8.1",
		"baseline-browser-mapping": "^2.9.11",
		"cloc": "^2.6.0-cloc",
		"dependency-cruiser": "^18.6.0",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"eslint-plugin-simple-import-sort": "^12.1.0",
		"globals": "^16.3.0",
		"happy-dom": "^20.10.6",
		"jiti": "^2.6.1",
		"kleur": "^4.1.5",
		"orval": "^8.5.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.2",
		"vite": "^7.1.2",
		"vite-tsconfig-paths": "^6.0.3",
		"vitest": "^4.1.2"
	}
}
